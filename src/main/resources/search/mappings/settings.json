{
  "settings": {
    "number_of_shards": 1,
    "auto_expand_replicas": "0-1",
    "refresh_interval": "5s"
  },
  "mappings": {
    "dynamic": true,
    "properties": {
      "burp": {
        "properties": {
          "project_id": { "type": "keyword", "ignore_above": 8191 },
          "version": { "type": "keyword", "ignore_above": 8191 }
        }
      },
      "meta": {
        "properties": {
          "schema_version": { "type": "keyword", "ignore_above": 8191 },
          "extension_version": { "type": "keyword", "ignore_above": 8191 },
          "indexed_at": { "type": "date" }
        }
      },
      "project": { "type": "object", "enabled": false },
      "user": { "type": "object", "enabled": false }
    }
  }
}
