{
  "settings": {
    "number_of_shards": 1,
    "auto_expand_replicas": "0-1",
    "refresh_interval": "5s"
  },
  "mappings": {
    "dynamic": true,
    "properties": {
      "event": {
        "properties": {
          "data": { "type": "object", "enabled": true },
          "level": { "type": "keyword", "ignore_above": 8191 },
          "source": { "type": "keyword", "ignore_above": 8191 },
          "summary": { "type": "text" },
          "thread": { "type": "keyword", "ignore_above": 8191 },
          "type": { "type": "keyword", "ignore_above": 8191 }
        }
      },
      "meta": {
        "properties": {
          "schema_version": { "type": "keyword", "ignore_above": 8191 },
          "extension_version": { "type": "keyword", "ignore_above": 8191 },
          "indexed_at": { "type": "date" }
        }
      }
    }
  }
}
